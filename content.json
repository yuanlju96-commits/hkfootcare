"<!DOCTYPE html>\n<html lang=\"zh-HK\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\">\n    <title>港康足護 HK FootCare · 香港專業足部健康護理</title>\n    <style>\n        * { margin: 0; padding: 0; box-sizing: border-box; }\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif;\n            background: #f5f7fa;\n            color: #2c2c2c;\n            line-height: 1.6;\n            padding-bottom: 80px;\n        }\n\n        /* ===== Hero ===== */\n        .hero {\n            background: linear-gradient(135deg, #1a3a5c 0%, #0f2a45 100%);\n            color: #fff;\n            padding: 50px 20px 40px;\n            text-align: center;\n            position: relative;\n        }\n        .hero::after {\n            content: '';\n            position: absolute;\n            bottom: -18px;\n            left: 0; right: 0;\n            height: 36px;\n            background: #f5f7fa;\n            border-radius: 50% 50% 0 0;\n        }\n        .hero-icon { font-size: 48px; margin-bottom: 10px; }\n        .hero h1 { font-size: 28px; font-weight: 700; letter-spacing: 2px; }\n        .hero h1 small { font-size: 14px; font-weight: 400; opacity: 0.8; display: block; margin-top: 4px; }\n        .hero .subtitle {\n            font-size: 14px; opacity: 0.9; margin-top: 8px;\n        }\n        .hero-tags {\n            display: flex; justify-content: center; gap: 8px; flex-wrap: wrap;\n            margin-top: 14px;\n        }\n        .hero-tags span {\n            background: rgba(255,255,255,0.12);\n            padding: 4px 12px; border-radius: 20px; font-size: 11px;\n        }\n        .hero .cta-btn {\n            display: inline-block;\n            background: #e8a838;\n            color: #fff;\n            font-size: 15px;\n            font-weight: 700;\n            padding: 10px 36px;\n            border-radius: 25px;\n            text-decoration: none;\n            margin-top: 16px;\n            transition: .2s;\n        }\n        .hero .cta-btn:active { transform: scale(0.96); opacity: 0.9; }\n\n        /* ===== Container ===== */\n        .container { max-width: 480px; margin: 0 auto; padding: 0 14px; }\n\n        /* ===== Section ===== */\n        .section { margin-top: 24px; }\n        .section-title {\n            font-size: 17px; font-weight: 700; color: #1a3a5c;\n            padding-left: 10px; border-left: 3px solid #e8a838; margin-bottom: 12px;\n        }\n\n        /* ===== Card ===== */\n        .card {\n            background: #fff; border-radius: 12px; padding: 16px;\n            box-shadow: 0 2px 8px rgba(0,0,0,0.06); margin-bottom: 12px;\n        }\n\n        /* ===== Services ===== */\n        .service-group {\n            background: #fff; border-radius: 12px;\n            box-shadow: 0 2px 8px rgba(0,0,0,0.06); margin-bottom: 14px;\n            overflow: hidden;\n        }\n        .service-header {\n            padding: 14px 16px;\n            background: #f0f4f8;\n            font-size: 15px; font-weight: 700; color: #1a3a5c;\n            border-bottom: 1px solid #e0e6ed;\n        }\n        .service-list { padding: 6px 16px 12px; }\n        .service-item {\n            display: flex; justify-content: space-between; align-items: center;\n            padding: 8px 0;\n            border-bottom: 1px solid #f0f0f0;\n        }\n        .service-item:last-child { border-bottom: none; }\n        .service-item .name {\n            font-size: 14px; color: #444;\n        }\n        .service-item .price {\n            font-size: 14px; font-weight: 700; color: #1a3a5c;\n        }\n        .service-item .price small { font-size: 11px; font-weight: 400; color: #888; }\n\n        .note-box {\n            background: #f8f4eb;\n            border-left: 3px solid #e8a838;\n            padding: 12px 14px;\n            font-size: 12px;\n            color: #666;\n            line-height: 1.6;\n            margin: 0 16px 14px;\n            border-radius: 0 6px 6px 0;\n        }\n\n        /* ===== Why Us ===== */\n        .why-grid { display: flex; flex-direction: column; gap: 8px; }\n        .why-item {\n            display: flex; align-items: flex-start; gap: 10px;\n            background: #fff; border-radius: 10px; padding: 12px 14px;\n            box-shadow: 0 2px 6px rgba(0,0,0,0.05);\n        }\n        .why-item .check { color: #1a8a5c; font-size: 16px; flex-shrink: 0; }\n        .why-item .text { font-size: 13px; color: #555; }\n\n        /* ===== Process ===== */\n        .process-list { counter-reset: step; }\n        .process-item {\n            display: flex; align-items: flex-start; gap: 14px;\n            padding: 12px 0;\n            border-bottom: 1px dashed #e0e0e0;\n        }\n        .process-item:last-child { border-bottom: none; }\n        .process-item .num {\n            width: 28px; height: 28px; flex-shrink: 0;\n            background: #1a3a5c; color: #fff; border-radius: 50%;\n            display: flex; align-items: center; justify-content: center;\n            font-size: 13px; font-weight: 700;\n        }\n        .process-item .text { font-size: 14px; color: #444; padding-top: 3px; }\n\n        /* ===== Contact ===== */\n        .contact-bar { display: flex; gap: 8px; margin: 14px 0; }\n        .contact-bar a {\n            flex: 1; text-align: center; padding: 12px 0; border-radius: 10px;\n            font-size: 14px; font-weight: 600; text-decoration: none;\n        }\n        .contact-bar a:active { opacity: 0.85; }\n        .btn-wa { background: #25D366; color: #fff; }\n        .btn-call { background: #1a3a5c; color: #fff; }\n\n        /* ===== Booking ===== */\n        .form-card {\n            background: #fff; border-radius: 12px; padding: 18px;\n            box-shadow: 0 2px 8px rgba(0,0,0,0.06);\n        }\n        .form-group { margin-bottom: 12px; }\n        .form-group label {\n            display: block; font-size: 13px; font-weight: 600; color: #444; margin-bottom: 4px;\n        }\n        .form-group input,\n        .form-group select,\n        .form-group textarea {\n            width: 100%; padding: 10px 12px; border: 1px solid #ddd;\n            border-radius: 8px; font-size: 14px; font-family: inherit;\n            background: #fafafa; transition: .2s;\n        }\n        .form-group input:focus,\n        .form-group select:focus,\n        .form-group textarea:focus {\n            outline: none; border-color: #1a3a5c; background: #fff;\n        }\n        .form-group textarea { resize: vertical; min-height: 60px; }\n        .form-group select { appearance: auto; }\n        .btn-submit {\n            width: 100%; padding: 14px;\n            background: linear-gradient(135deg, #1a3a5c, #0f2a45);\n            color: #fff; border: none; border-radius: 10px;\n            font-size: 16px; font-weight: 600; cursor: pointer;\n        }\n        .btn-submit:active { transform: scale(0.98); }\n\n        /* ===== Sticky CTA ===== */\n        .sticky-cta {\n            position: fixed; bottom: 0; left: 0; right: 0;\n            background: #fff; padding: 10px 14px 16px;\n            box-shadow: 0 -2px 12px rgba(0,0,0,0.1);\n            display: flex; gap: 8px; z-index: 100;\n        }\n        .sticky-cta a {\n            flex: 1; text-align: center; padding: 12px 0; border-radius: 10px;\n            font-size: 14px; font-weight: 600; text-decoration: none;\n        }\n        .sticky-cta .wa { background: #25D366; color: #fff; }\n\n        /* ===== Footer ===== */\n        .footer { text-align: center; padding: 18px; font-size: 12px; color: #999; }\n\n        .toast {\n            position: fixed; top: 20px; left: 50%; transform: translateX(-50%);\n            background: #1a3a5c; color: #fff; padding: 12px 24px;\n            border-radius: 8px; font-size: 14px; z-index: 200;\n            opacity: 0; transition: .3s; pointer-events: none;\n        }\n        .toast.show { opacity: 1; }\n\n        @media (max-width: 400px) {\n            .hero h1 { font-size: 22px; }\n            .contact-bar { flex-direction: column; }\n        }\n    </style>\n</head>\n<body>\n\n    <div class=\"toast\" id=\"toast\"></div>\n\n    <!-- ===== Hero ===== -->\n    <div class=\"hero\">\n        <div class=\"hero-icon\">🦶</div>\n        <h1>港康足護 <small>HK FootCare</small></h1>\n        <p class=\"subtitle\">香港專業足部健康護理</p>\n        <div class=\"hero-tags\">\n            <span>📍 香港工作室</span>\n            <span>🚗 上門服務</span>\n            <span>📅 全預約制</span>\n        </div>\n        <a href=\"https://wa.me/85295564471?text=你好，我想預約港康足護服務\" class=\"cta-btn\" target=\"_blank\">📲 立即預約</a>\n    </div>\n\n    <div class=\"container\">\n\n        <!-- ===== Services ===== -->\n        <div class=\"section\">\n            <div class=\"section-title\">🔹 足部問題護理</div>\n\n            <div class=\"service-group\">\n                <div class=\"service-header\">建議價格（HKD）</div>\n                <div class=\"service-list\">\n                    <div class=\"service-item\">\n                        <span class=\"name\">修腳護理</span>\n                        <span class=\"price\">$280 <small>起</small></span>\n                    </div>\n                    <div class=\"service-item\">\n                        <span class=\"name\">灰指甲護理</span>\n                        <span class=\"price\">$380 <small>起</small></span>\n                    </div>\n                    <div class=\"service-item\">\n                        <span class=\"name\">甲溝炎護理</span>\n                        <span class=\"price\">$380 <small>起</small></span>\n                    </div>\n                    <div class=\"service-item\">\n                        <span class=\"name\">嵌甲矯正</span>\n                        <span class=\"price\">$480 <small>起</small></span>\n                    </div>\n                    <div class=\"service-item\">\n                        <span class=\"name\">雞眼護理</span>\n                        <span class=\"price\">$300 <small>起</small></span>\n                    </div>\n                    <div class=\"service-item\">\n                        <span class=\"name\">厚甲修護</span>\n                        <span class=\"price\">$320 <small>起</small></span>\n                    </div>\n                    <div class=\"service-item\">\n                        <span class=\"name\">老繭／硬皮護理</span>\n                        <span class=\"price\">$280 <small>起</small></span>\n                    </div>\n                    <div class=\"service-item\">\n                        <span class=\"name\">足部保養</span>\n                        <span class=\"price\">$380 <small>起</small></span>\n                    </div>\n                </div>\n                <div class=\"note-box\">\n                    ⚠️ 實際收費將根據足部情況、護理難度及所需時間評估，<br>\n                    護理前會先説明服務內容及費用。\n                </div>\n            </div>\n\n            <div class=\"service-group\">\n                <div class=\"service-header\">足部健康保養</div>\n                <div class=\"service-list\">\n                    <div class=\"service-item\"><span class=\"name\">修腳護理</span><span class=\"price\"></span></div>\n                    <div class=\"service-item\"><span class=\"name\">足部深層清潔</span><span class=\"price\"></span></div>\n                    <div class=\"service-item\"><span class=\"name\">足部角質管理</span><span class=\"price\"></span></div>\n                    <div class=\"service-item\"><span class=\"name\">足部保養護理</span><span class=\"price\"></span></div>\n                </div>\n            </div>\n\n            <div class=\"card\" style=\"text-align:center;padding:14px;\">\n                <p style=\"font-size:14px;color:#555;\">🏠 工作室 / 🚗 上門服務</p>\n                <div style=\"display:flex;flex-wrap:wrap;gap:4px;justify-content:center;margin-top:8px;\">\n                    <span style=\"background:#e8f0fe;padding:4px 10px;border-radius:16px;font-size:12px;color:#1a3a5c;\">✔ 工作室預約</span>\n                    <span style=\"background:#e8f0fe;padding:4px 10px;border-radius:16px;font-size:12px;color:#1a3a5c;\">✔ 香港上門服務</span>\n                    <span style=\"background:#e8f0fe;padding:4px 10px;border-radius:16px;font-size:12px;color:#1a3a5c;\">✔ 長者足部護理</span>\n                    <span style=\"background:#e8f0fe;padding:4px 10px;border-radius:16px;font-size:12px;color:#1a3a5c;\">✔ 行動不便人士服務</span>\n                </div>\n            </div>\n        </div>\n\n        <!-- ===== Why Us ===== -->\n        <div class=\"section\">\n            <div class=\"section-title\">為什麼選擇港康足護</div>\n            <div class=\"why-grid\">\n                <div class=\"why-item\">\n                    <span class=\"check\">✅</span>\n                    <span class=\"text\">一人一套消毒工具</span>\n                </div>\n                <div class=\"why-item\">\n                    <span class=\"check\">✅</span>\n                    <span class=\"text\">專業足部護理技術</span>\n                </div>\n                <div class=\"why-item\">\n                    <span class=\"check\">✅</span>\n                    <span class=\"text\">預約制服務</span>\n                </div>\n                <div class=\"why-item\">\n                    <span class=\"check\">✅</span>\n                    <span class=\"text\">工作室及香港上門服務</span>\n                </div>\n                <div class=\"why-item\">\n                    <span class=\"check\">✅</span>\n                    <span class=\"text\">注重衞生、安全及私隱</span>\n                </div>\n            </div>\n        </div>\n\n        <!-- ===== Process ===== -->\n        <div class=\"section\">\n            <div class=\"section-title\">預約流程</div>\n            <div class=\"card process-list\">\n                <div class=\"process-item\">\n                    <div class=\"num\">1</div>\n                    <div class=\"text\">聯絡客服</div>\n                </div>\n                <div class=\"process-item\">\n                    <div class=\"num\">2</div>\n                    <div class=\"text\">發送足部照片初步評估</div>\n                </div>\n                <div class=\"process-item\">\n                    <div class=\"num\">3</div>\n                    <div class=\"text\">安排時間</div>\n                </div>\n                <div class=\"process-item\">\n                    <div class=\"num\">4</div>\n                    <div class=\"text\">工作室／上門服務</div>\n                </div>\n                <div class=\"process-item\">\n                    <div class=\"num\">5</div>\n                    <div class=\"text\">完成護理及後續建議</div>\n                </div>\n            </div>\n        </div>\n\n        <!-- ===== Booking ===== -->\n        <div class=\"section\">\n            <div class=\"section-title\">📅 預約服務</div>\n            <div class=\"form-card\">\n                <form id=\"bookingForm\">\n                    <div class=\"form-group\">\n                        <label for=\"name\">姓名 *</label>\n                        <input type=\"text\" id=\"name\" name=\"name\" required placeholder=\"您的稱呼\">\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"phone\">電話 *</label>\n                        <input type=\"tel\" id=\"phone\" name=\"phone\" required placeholder=\"方便聯繫您\">\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"service\">預約項目 *</label>\n                        <select id=\"service\" name=\"service\" required>\n                            <option value=\"\">請選擇服務</option>\n                            <option value=\"修腳護理\">修腳護理</option>\n                            <option value=\"灰指甲護理\">灰指甲護理</option>\n                            <option value=\"甲溝炎護理\">甲溝炎護理</option>\n                            <option value=\"嵌甲矯正\">嵌甲矯正</option>\n                            <option value=\"雞眼護理\">雞眼護理</option>\n                            <option value=\"厚甲修護\">厚甲修護</option>\n                            <option value=\"老繭硬皮護理\">老繭／硬皮護理</option>\n                            <option value=\"足部保養\">足部保養</option>\n                            <option value=\"足部深層清潔\">足部深層清潔</option>\n                            <option value=\"足部角質管理\">足部角質管理</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"serviceType\">服務方式 *</label>\n                        <select id=\"serviceType\" name=\"serviceType\" required>\n                            <option value=\"\">請選擇</option>\n                            <option value=\"工作室\">工作室（到店）</option>\n                            <option value=\"上門\">上門服務</option>\n                        </select>\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"date\">期望日期</label>\n                        <input type=\"date\" id=\"date\" name=\"date\">\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"note\">備註</label>\n                        <textarea id=\"note\" name=\"note\" placeholder=\"上門請填地址／長者或行動不便請標註\"></textarea>\n                    </div>\n                    <button type=\"submit\" class=\"btn-submit\">📲 提交預約</button>\n                </form>\n                <p style=\"text-align:center;font-size:12px;color:#999;margin-top:10px;\">\n                    提交後透過 WhatsApp 與您確認\n                </p>\n            </div>\n        </div>\n\n        <!-- ===== Footer ===== -->\n        <div class=\"section\">\n            <div class=\"section-title\">聯絡我們</div>\n            <div class=\"card\">\n                <p style=\"font-size:14px;\">📍 長沙灣青山道香港工業中心 B 座</p>\n                <p style=\"font-size:14px;margin-top:6px;\">🚗 香港上門服務</p>\n                <p style=\"font-size:14px;margin-top:6px;\">📅 全預約制</p>\n                <div class=\"contact-bar\">\n                    <a href=\"https://wa.me/85295564471?text=你好，我想預約港康足護服務\" class=\"btn-wa\" target=\"_blank\">💬 WhatsApp</a>\n                    <a href=\"tel:+85295564471\" class=\"btn-call\">📞 致電</a>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"footer\">\n            <p>🦶 港康足護 HK FootCare</p>\n            <p style=\"margin-top:4px;\">香港專業足部健康護理 · 全預約制</p>\n        </div>\n\n    </div>\n\n    <!-- ===== Sticky CTA ===== -->\n    <div class=\"sticky-cta\">\n        <a href=\"https://wa.me/85295564471?text=你好，我想預約港康足護服務\" class=\"wa\" target=\"_blank\">💬 WhatsApp 預約</a>\n    </div>\n\n    <script>>\n        function showToast(msg) {\n            const t = document.getElementById('toast');\n            t.textContent = msg;\n            t.classList.add('show');\n            setTimeout(() = t.classList.remove('show'), 3000);\n        }\n\n        document.getElementById('bookingForm').addEventListener('submit', function(e) {\n            e.preventDefault();\n            const name = document.getElementById('name').value.trim();\n            const phone = document.getElementById('phone').value.trim();\n            const service = document.getElementById('service').value;\n            const serviceType = document.getElementById('serviceType').value;\n            const date = document.getElementById('date').value;\n            const note = document.getElementById('note').value.trim();\n\n            if (!name || !phone || !service || !serviceType) {\n                showToast('請填寫完整信息');\n                return;\n            }\n\n            let msg = `【預約】港康足護\\n`;\n            msg += `姓名：${name}\\n`;\n            msg += `電話：${phone}\\n`;\n            msg += `項目：${service}\\n`;\n            msg += `方式：${serviceType}\\n`;\n            if (date) msg += `日期：${date}\\n`;\n            if (note) msg += `備註：${note}\\n`;\n\n            window.open(`https://wa.me/85295564471?text=${encodeURIComponent(msg)}`, '_blank');\n            showToast('✅ 預約信息已發送，請透過 WhatsApp 確認');\n        });\n\n        const dateInput = document.getElementById('date');\n        if (dateInput) {\n            dateInput.setAttribute('min', new Date().toISOString().split('T')[0]);\n        }\n    </script>\n\n</body>\n</html>\n"